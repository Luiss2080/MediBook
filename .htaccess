# MediBook - Configuración Apache Simplificada
DirectoryIndex index.php index.html

# Habilitar RewriteEngine (solo si es necesario)
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Solo permitir acceso a archivos que existen
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Seguridad básica - Proteger archivos sensibles
<FilesMatch "\.(env|git|htaccess)">
    Order allow,deny
    Deny from all
</FilesMatch>