# Application
APP_NAME=MediBook
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=medibook
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contraseña-app
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@medibook.com
MAIL_FROM_NAME="${APP_NAME}"

# Security
SESSION_LIFETIME=120
SESSION_SECURE=false
CSRF_TOKEN_NAME=csrf_token

# Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx

# Notifications
NOTIFICATION_REMINDER_HOURS=24
NOTIFICATION_ENABLED=true

# Pagination
ITEMS_PER_PAGE=15

# Cache
CACHE_DRIVER=file
CACHE_LIFETIME=3600

# Logs
LOG_LEVEL=debug
LOG_CHANNEL=daily